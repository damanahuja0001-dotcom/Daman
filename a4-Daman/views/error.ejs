<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pizza - Error</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1>Langara Pizza</h1>
        <p class="tagline">Online Order Form</p>
    </header>
    <a href="/">Home</a>
    <h2>Error</h2>
    <dl>
        <% errors.forEach(function(error) { %>
            <dt><%= error.field %>:</dt>
            <dd><%= error.message %></dd>
        <% }); %>
    </dl>
</body>
</html>
